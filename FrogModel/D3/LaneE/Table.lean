  intro m hm1 hm2
  obtain ⟨hmem, hml, hmh⟩ := pickE_spec rest e3 m linked_tbl hm1 hm2
  have hc : (pickE rest e3 m).check = true := by
    rcases hmem with h | h
    · rw [h]; exact e3_check
    · exact List.all_eq_true.mp rest_check _ h
  exact Entry.sound _ hc m hml hmh Jf Df kf yf k1f rfl rfl rfl rfl rfl

